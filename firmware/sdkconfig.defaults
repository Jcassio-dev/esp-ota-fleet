# Flash e tabela de partições
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Rollback pelo bootloader: a versão nova sobe em PENDING_VERIFY e só fica se for marcada válida
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Verificação da assinatura (ECDSA P-256 sobre SHA-256)
CONFIG_MBEDTLS_ECDSA_C=y
CONFIG_MBEDTLS_ECP_DP_SECP256R1_ENABLED=y

# O laço principal faz HTTP e parse de JSON
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
